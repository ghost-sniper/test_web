{
  "version": 1,
  "cors": {
    "origins": [
      "*"
    ],
    "allow_headers": "Content-Type, Authorization",
    "max_age": 600
  },
  "routes": [
    {
      "method": "POST",
      "path": "/hello/test",
      "request": {
        "body_required": true,
        "fields": [
          {
            "name": "name",
            "type": "string",
            "default": ""
          },
          {
            "name": "age",
            "type": "integer",
            "default": 0
          },
          {
            "name": "email",
            "type": "string",
            "default": ""
          }
        ]
      },
      "rules": [
        {
          "id": "hello",
          "response": {
            "template": true,
            "body": {
              "message": "{{body.name}}明年这个时候你是{{body.age|add:1}}岁",
              "code": 200
            },
            "status": 200,
            "delay_ms": 250,
            "headers": []
          },
          "priority": 0,
          "match": {
            "body": null,
            "query": [],
            "headers": []
          }
        }
      ],
      "rate_limit": {
        "requests_per_second": 500,
        "clients": []
      }
    },
    {
      "method": "POST",
      "path": "/order",
      "request": {
        "body_required": true,
        "fields": [
          {
            "name": "product_name",
            "type": "string",
            "required": true
          },
          {
            "name": "product_id",
            "type": "integer",
            "required": true
          },
          {
            "name": "order_id",
            "type": "string",
            "required": true
          },
          {
            "name": "count",
            "type": "integer",
            "required": true
          },
          {
            "name": "buyer_account",
            "type": "string",
            "required": true
          },
          {
            "name": "pay_method",
            "type": "string",
            "required": true
          }
        ]
      },
      "rules": [
        {
          "id": "order-unionpay",
          "priority": 100,
          "match": {
            "body": {
              "pay_method": "UnionPay"
            },
            "query": [],
            "headers": []
          },
          "response": {
            "status": 400,
            "body": {
              "code": 400,
              "message": "不支持银联支付方式"
            },
            "delay_ms": 150,
            "template": false,
            "headers": []
          }
        },
        {
          "id": "order-success",
          "priority": 0,
          "response": {
            "body": {
              "code": 200,
              "message": "下单成功"
            },
            "status": 200,
            "delay_ms": 0,
            "template": false,
            "headers": []
          },
          "match": {
            "body": null,
            "query": [],
            "headers": []
          }
        }
      ],
      "rate_limit": {
        "requests_per_second": 200,
        "clients": []
      }
    },
    {
      "method": "POST",
      "path": "/examples/jsonpath",
      "folder_id": "mock-examples",
      "request": { "format": "json", "body_required": true },
      "rules": [
        {
          "id": "paid-order",
          "match": {
            "body_expression": {
              "mode": "jsonpath",
              "expression": "$.orders[?@.qty >= 2].status",
              "expected": { "value": "paid" }
            }
          },
          "response": { "body": { "matched": "jsonpath" } }
        }
      ]
    },
    {
      "method": "POST",
      "path": "/examples/xpath",
      "folder_id": "mock-examples",
      "request": { "format": "xml", "body_required": true },
      "rules": [
        {
          "id": "paid-order",
          "match": {
            "body_expression": {
              "mode": "xpath",
              "expression": "/o:order[o:status='paid']",
              "namespaces": [{ "prefix": "o", "uri": "urn:orders" }]
            }
          },
          "response": { "body": { "matched": "xpath" } }
        }
      ]
    },
    {
      "method": "GET",
      "path": "/examples/query",
      "folder_id": "mock-examples",
      "rules": [
        {
          "id": "paid-from-web",
          "match": {
            "query": [
              { "name": "status", "value": "paid" },
              { "name": "source", "value": "web" }
            ]
          },
          "response": { "body": { "matched": "query" } }
        }
      ]
    },
    {
      "method": "GET",
      "path": "/examples/items/{id}",
      "folder_id": "mock-examples",
      "rules": [
        {
          "id": "item-42",
          "match": { "path": [{ "name": "id", "value": "42" }] },
          "response": { "body": { "matched": "path", "id": 42 } }
        }
      ]
    },
    {
      "method": "POST",
      "path": "/examples/regex",
      "folder_id": "mock-examples",
      "request": { "format": "json", "body_required": true },
      "rules": [
        {
          "id": "order-code",
          "match": {
            "body_expression": {
              "mode": "regex",
              "expression": "\"code\"\\s*:\\s*\"AB-\\d{2}\""
            }
          },
          "response": { "body": { "matched": "regex" } }
        }
      ]
    },
    {
      "method": "POST",
      "path": "/examples/template/json",
      "folder_id": "mock-examples",
      "request": {
        "format": "json",
        "body_required": true,
        "fields": [{ "name": "name", "type": "string", "required": true }]
      },
      "rules": [
        {
          "id": "greet",
          "response": {
            "format": "json",
            "template": true,
            "body": { "message": "Hello, {{body.name}}!" }
          }
        }
      ]
    },
    {
      "method": "POST",
      "path": "/examples/template/xml",
      "folder_id": "mock-examples",
      "request": { "format": "xml", "body_required": true },
      "rules": [
        {
          "id": "greet",
          "response": {
            "format": "xml",
            "template": true,
            "body": "<greeting>Hello, {{body.name}}!</greeting>"
          }
        }
      ]
    }
  ],
  "folders": [
    {
      "id": "mock-examples",
      "name": "Examples"
    }
  ]
}
