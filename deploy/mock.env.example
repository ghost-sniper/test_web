# Linux (systemd EnvironmentFile)
MOCK_HOST=127.0.0.1
MOCK_PORT=9080
MOCK_CONFIG=/var/lib/zig-mock/mock.json
# Optional stable admin token (at least 16 characters). Keep this file readable only by root.
# Empty generates a new token on every startup and prints it to the terminal (systemd journal).
MOCK_ADMIN_TOKEN=

# Windows (PowerShell, from the project root)
# Copy the commands below without the leading "# ".
# $env:MOCK_HOST = '127.0.0.1'
# $env:MOCK_PORT = '9080'
# $env:MOCK_CONFIG = 'config/mock.json'
# $env:MOCK_ADMIN_TOKEN = '' # Empty generates and prints a token on startup.
# .\zig-out\bin\test_web.exe

# macOS (zsh or Bash, from the project root)
# Copy the commands below without the leading "# ".
# export MOCK_HOST=127.0.0.1
# export MOCK_PORT=9080
# export MOCK_CONFIG='config/mock.json'
# export MOCK_ADMIN_TOKEN='' # Empty generates and prints a token on startup.
# ./zig-out/bin/test_web
